{
    "name": "qubus/support",
    "type": "library",
    "description": "Support package.",
    "keywords": [
        "support",
        "assets",
        "container",
        "datetime",
        "serializer"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Joshua Parker",
            "email": "joshua@joshuaparker.dev"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "ext-zlib": "*",
        "cocur/slugify": "^4",
        "mrclay/minify": "^4",
        "nesbot/carbon": "^2.73",
        "psr/container": "^2",
        "psr/log": "^3",
        "qubus/event-dispatcher": "^4",
        "qubus/exception": "^4",
        "qubus/inheritance": "^4",
        "symfony/var-dumper": "^7",
        "webmozart/assert": "^1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "qubus/qubus-coding-standard": "^2"
    },
    "autoload": {
        "psr-4": {
            "Qubus\\Support\\": "src/"
        },
        "files": [
            "src/Helpers/core.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Qubus\\Tests\\Support\\": "Tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "qubestan": "phpstan analyse -l 3"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
